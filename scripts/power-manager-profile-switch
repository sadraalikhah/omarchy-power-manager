#!/bin/bash
set -euo pipefail
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# 1. Resolve Config File
CONFIG_FILE="${OMARCHY_POWER_CONF:-${1:-}}"
if [ -z "$CONFIG_FILE" ]; then
    CANDIDATES=()
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then CANDIDATES+=("$XDG_CONFIG_HOME/onlyvishesh.power-manager.json"); fi
    if [ -n "${HOME:-}" ]; then CANDIDATES+=("$HOME/.config/onlyvishesh.power-manager.json"); fi
    for u_home in /home/*; do
        if [ -d "$u_home/.config" ]; then CANDIDATES+=("$u_home/.config/onlyvishesh.power-manager.json"); fi
    done
    for cand in "${CANDIDATES[@]}"; do
        if [ -f "$cand" ]; then CONFIG_FILE="$cand"; break; fi
    done
fi

PREV="none"
if command -v powerprofilesctl >/dev/null 2>&1; then PREV=$(powerprofilesctl get 2>/dev/null || echo "none"); fi
NEW_PROF="balanced"; REASON="default"

PSY_PATH="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"
AC_ONLINE=false
if [ -d "$PSY_PATH" ]; then
    for supply in "$PSY_PATH"/*; do
        [ -d "$supply" ] || continue
        type=$(cat "$supply/type" 2>/dev/null || true)
        if [[ "$type" =~ ^(Mains|USB|USB_PD|USB_C)$ ]]; then
            if [ "$(cat "$supply/online" 2>/dev/null | tr -d '[:space:]')" = "1" ]; then
                AC_ONLINE=true; break
            fi
        fi
    done
fi

BAT_COUNT=0; BAT_CAP_SUM=0; BAT_PRESENT=false
if [ -d "$PSY_PATH" ]; then
    for supply in "$PSY_PATH"/*; do
        [ -d "$supply" ] || continue
        is_bat=false
        type=$(cat "$supply/type" 2>/dev/null || true)
        if [ "$type" = "Battery" ] || [[ "$(basename "$supply")" =~ ^BAT[0-9]+ ]]; then is_bat=true; fi
        if [ "$is_bat" = "true" ]; then
            BAT_PRESENT=true
            if [ -r "$supply/capacity" ]; then
                cap=$(cat "$supply/capacity" 2>/dev/null | tr -d '[:space:]' || echo "")
                if [[ "$cap" =~ ^[0-9]+$ ]]; then
                    BAT_CAP_SUM=$((BAT_CAP_SUM + cap)); BAT_COUNT=$((BAT_COUNT + 1))
                fi
            fi
        fi
    done
fi
BAT_CAP=$(( BAT_COUNT > 0 ? BAT_CAP_SUM / BAT_COUNT : 100 ))

ENABLED="true"
PROF_AC="performance"; PROF_BAT_HIGH="balanced"; PROF_BAT_LOW="power-saver"; BAT_THRESH=30

if [ -n "$CONFIG_FILE" ] && [ -f "$CONFIG_FILE" ] && jq empty "$CONFIG_FILE" 2>/dev/null; then
    ENABLED=$(jq -r 'if has("enabled") and .enabled == false then "false" else "true" end' "$CONFIG_FILE" 2>/dev/null || echo "true")
    PROF_AC=$(jq -r '(.profiles?.ac // "performance")' "$CONFIG_FILE" 2>/dev/null || echo "performance")
    PROF_BAT_HIGH=$(jq -r '(.profiles?.batteryHigh // "balanced")' "$CONFIG_FILE" 2>/dev/null || echo "balanced")
    PROF_BAT_LOW=$(jq -r '(.profiles?.batteryLow // "power-saver")' "$CONFIG_FILE" 2>/dev/null || echo "power-saver")
    BAT_THRESH=$(jq -r '(.batteryThreshold // 30)' "$CONFIG_FILE" 2>/dev/null || echo "30")
    

fi
if ! [[ "$BAT_THRESH" =~ ^[0-9]+$ ]]; then BAT_THRESH=30; fi
for profile in "$PROF_AC" "$PROF_BAT_HIGH" "$PROF_BAT_LOW"; do
    case "$profile" in power-saver|balanced|performance) ;; *) echo 'Invalid power profile' >&2; exit 1 ;; esac
done

STATE_KEY="ac"
if [ "$ENABLED" = "false" ]; then
    NEW_PROF="$PREV"; REASON="disabled"; STATE_KEY="ac"
else
    if [ "$AC_ONLINE" = "true" ] || [ "$BAT_PRESENT" = "false" ]; then
        NEW_PROF="$PROF_AC"; REASON="ac_connected"; STATE_KEY="ac"
    else
        if [ "$BAT_CAP" -le "$BAT_THRESH" ]; then
            NEW_PROF="$PROF_BAT_LOW"; REASON="low_battery"; STATE_KEY="batteryLow"
        else
            NEW_PROF="$PROF_BAT_HIGH"; REASON="battery"; STATE_KEY="batteryHigh"
        fi
    fi
fi
if [ -z "$NEW_PROF" ] || [ "$NEW_PROF" = "null" ]; then NEW_PROF="balanced"; fi

if [ "$ENABLED" = "true" ]; then
    # PROFILE SWITCH
    if [ "$NEW_PROF" != "none" ]; then
        source_mode=battery
        [[ "$STATE_KEY" == ac ]] && source_mode=ac
        if [ "$(id -u)" -eq 0 ]; then
            config_owner=$(stat -c '%U' -- "$CONFIG_FILE")
            [[ "$config_owner" != root && "$config_owner" != UNKNOWN ]] || { echo 'Config must belong to the desktop user' >&2; exit 1; }
            runuser -u "$config_owner" -- /usr/bin/omarchy-powerprofiles-set "$source_mode" "$NEW_PROF"
        else
            omarchy-powerprofiles-set "$source_mode" "$NEW_PROF"
        fi
    fi

    # DYNAMIC LOGIND CONFIGURATION
    if [ "$(id -u)" -eq 0 ] || [ -n "${OMARCHY_SYSTEMD_LOGIND_DIR:-}" ] || [ -n "${OMARCHY_SYSTEMD_SLEEP_DIR:-}" ]; then
        # Parse configs
        IDLE_MINS=$(jq -r ".idle?.${STATE_KEY}?.sleepAfterMinutes // 15" "$CONFIG_FILE" 2>/dev/null || echo 15)
        IDLE_ACT=$(jq -r ".idle?.${STATE_KEY}?.afterSleep // \"suspend\"" "$CONFIG_FILE" 2>/dev/null || echo "suspend")
        
        HIB_MINS=$(jq -r ".idle?.${STATE_KEY}?.hibernateAfterMinutes // 15" "$CONFIG_FILE")
        
        LID_IGN=$(jq -r 'if .lid?.ignoreLidClose == true then "true" else "false" end' "$CONFIG_FILE" 2>/dev/null || echo "false")
        LID_AC_ACT=$(jq -r '.lid?.ac?.action // "suspend"' "$CONFIG_FILE" 2>/dev/null || echo "suspend")
        if [ "$STATE_KEY" = "batteryLow" ]; then
            LID_BAT_ACT=$(jq -r '.lid?.batteryLow?.action // .lid?.battery?.action // "suspend"' "$CONFIG_FILE" 2>/dev/null || echo "suspend")
        else
            LID_BAT_ACT=$(jq -r '.lid?.batteryHigh?.action // .lid?.battery?.action // "suspend"' "$CONFIG_FILE" 2>/dev/null || echo "suspend")
        fi
        
        if [ "$LID_IGN" = "true" ]; then
            LID_AC_ACT="ignore"
            LID_BAT_ACT="ignore"
        fi

        for minutes in "$IDLE_MINS" "$HIB_MINS"; do
            [[ "$minutes" =~ ^[0-9]+$ ]] && (( minutes <= 10080 )) || { echo 'Invalid sleep duration' >&2; exit 1; }
        done
        for action in "$IDLE_ACT" "$LID_AC_ACT" "$LID_BAT_ACT"; do
            case "$action" in ignore|suspend|hibernate|suspend-then-hibernate|hybrid-sleep|poweroff) ;; *) echo 'Invalid sleep action' >&2; exit 1 ;; esac
        done
        
        HIB_SEC=$((HIB_MINS * 60))
        
        LOGIND_DIR="${OMARCHY_SYSTEMD_LOGIND_DIR:-/etc/systemd/logind.conf.d}"
        SLEEP_DIR="${OMARCHY_SYSTEMD_SLEEP_DIR:-/etc/systemd/sleep.conf.d}"
        mkdir -p "$LOGIND_DIR" "$SLEEP_DIR" 2>/dev/null || true
        
        cat <<INI > "$LOGIND_DIR/90-power-manager.conf"
[Login]
HandleLidSwitch=$LID_BAT_ACT
HandleLidSwitchExternalPower=$LID_AC_ACT
HandleLidSwitchDocked=ignore
IdleAction=ignore
INI
        
        cat <<INI > "$SLEEP_DIR/90-power-manager.conf"
[Sleep]
HibernateDelaySec=$HIB_SEC
HibernateOnACPower=yes
INI
        
        
        systemctl kill -s HUP systemd-logind 2>/dev/null || true
    fi
fi

echo "{\"previous\": \"$PREV\", \"current\": \"$NEW_PROF\", \"state\": \"$STATE_KEY\", \"reason\": \"$REASON\", \"success\": true}"
exit 0
